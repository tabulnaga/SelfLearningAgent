# Copy to .env and fill in. Never commit .env.

# --- runtime ---------------------------------------------------------------
APP_ENV=sim                      # sim | staging | prod  (write tools auto-run only in sim)
LOG_LEVEL=INFO
# Comma-separated key:tenant:role1|role2. Empty = auth disabled (allowed only in APP_ENV=sim).
API_KEYS=

# --- LLM (application) ------------------------------------------------------
LLM_PROVIDER=anthropic           # anthropic | fake
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=               # used by the app AND passed to Hindsight

# --- Hindsight (learned memory) --------------------------------------------
HINDSIGHT_ENABLED=true
HINDSIGHT_URL=http://localhost:8888
HINDSIGHT_BANK_ID=support-ops
HINDSIGHT_LLM_MODEL=claude-opus-5-5          # Hindsight retain/consolidation
HINDSIGHT_REFLECT_LLM_MODEL=claude-haiku-4-5 # Hindsight reflect + knowledge pages (needs forced tool use)
RECALL_BUDGET=low
RETAIN_ASYNC=true
RETAIN_MIN_CONFIDENCE=0.5

# --- database --------------------------------------------------------------
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent

# --- RAG -------------------------------------------------------------------
RAG_TOP_K=8
RERANK_TOP_K=5
RERANK_ENABLED=true

# --- sessions --------------------------------------------------------------
SESSION_TIMEOUT_MINUTES=30
MONITOR_INTERVAL_S=30
